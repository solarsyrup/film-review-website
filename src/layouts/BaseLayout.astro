---
const { title = "Journal", description = "A personal film journal." } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#20201e" />
  <script is:inline>
    try {
      const savedTheme = localStorage.getItem("atc-theme");
      if (savedTheme === "light" || savedTheme === "dark") {
        document.documentElement.dataset.theme = savedTheme;
      }
    } catch (_) {}
  </script>
  <title>{title} · After the Credits</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap" rel="stylesheet" />
  <style is:global>
    :root {
      color-scheme: dark;
      --bg: #20201e;
      --surface: #282724;
      --text: #e8e2d8;
      --muted: #aaa398;
      --line: #494640;
      --accent: #c16b56;
      --body-copy: #d0c9bd;
      --max: 820px;
    }
    :root[data-theme="light"] {
      color-scheme: light;
      --bg: #f5f1e8;
      --surface: #eee8dc;
      --text: #24221f;
      --muted: #716b61;
      --line: #cfc7b8;
      --accent: #8b3d2e;
      --body-copy: #4e4941;
    }
    * { box-sizing: border-box; }
    html { background: var(--bg); scroll-behavior: smooth; }
    body { margin: 0; background: var(--bg); color: var(--text); font-family: "DM Sans", sans-serif; line-height: 1.72; transition: background .18s ease, color .18s ease; }
    a { color: inherit; text-decoration: none; text-decoration-thickness: 1px; text-underline-offset: 4px; }
    a:hover { color: var(--accent); }
    button { font: inherit; }
    .shell { width: min(var(--max), calc(100% - 44px)); margin-inline: auto; }
    header { border-bottom: 1px solid var(--line); }
    .topbar { min-height: 82px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
    .brand { font-family: "Newsreader", Georgia, serif; font-size: 1.7rem; letter-spacing: -.055em; line-height: 1; }
    .brand span { color: var(--accent); }
    .nav-side { display: flex; align-items: center; gap: 24px; }
    nav { display: flex; gap: 22px; font: .72rem "DM Mono", monospace; color: var(--muted); text-transform: uppercase; letter-spacing: .08em; }
    .theme-toggle { border: 1px solid var(--line); background: transparent; color: var(--text); border-radius: 2px; padding: 7px 10px; cursor: pointer; font: .68rem "DM Mono", monospace; white-space: nowrap; }
    .theme-toggle:hover { border-color: var(--accent); color: var(--accent); }
    .theme-toggle:focus-visible, a:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
    main { min-height: 66vh; }
    footer { border-top: 1px solid var(--line); margin-top: 82px; padding: 24px 0 34px; color: var(--muted); font: .68rem "DM Mono", monospace; display: flex; justify-content: space-between; gap: 20px; letter-spacing: .04em; }
    .eyebrow { font: .7rem "DM Mono", monospace; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); }
    h1, h2, h3 { font-family: "Newsreader", Georgia, serif; font-weight: 400; letter-spacing: -.045em; line-height: 1.08; }
    h1 { font-size: clamp(2.8rem, 8vw, 5.1rem); margin: 17px 0 20px; }
    h2 { font-size: 2rem; }
    p { margin: 0 0 1.15rem; }
    .muted { color: var(--muted); }
    .rule { border: 0; border-top: 1px solid var(--line); margin: 34px 0; }
    .hero { padding: 78px 0 54px; }
    .hero h1 { max-width: 720px; }
    .hero p { max-width: 600px; font-size: 1.07rem; color: var(--body-copy); }
    .section-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 20px; margin-bottom: 8px; }
    .section-heading h2 { margin: 0; }
    .review-list { list-style: none; padding: 0; margin: 0; }
    .review-row { padding: 23px 0; border-top: 1px solid var(--line); display: grid; grid-template-columns: 1fr auto; gap: 10px 26px; }
    .review-row h3 { font-size: 1.75rem; margin: 0 0 5px; }
    .review-meta { font: .69rem "DM Mono", monospace; color: var(--muted); letter-spacing: .02em; }
    .rating { font: .78rem "DM Mono", monospace; color: var(--accent); white-space: nowrap; padding-top: 7px; }
    .summary { grid-column: 1 / -1; max-width: 650px; color: var(--body-copy); font-size: .96rem; margin-bottom: 0; }
    .text-link { display: inline-block; border-bottom: 1px solid var(--line); padding-bottom: 2px; }
    .empty { padding: 34px 0; color: var(--muted); }
    .article-head { padding: 64px 0 35px; }
    .article-head h1 { font-size: clamp(2.7rem, 7vw, 4.5rem); max-width: 740px; }
    .article-summary { font-family: "Newsreader", Georgia, serif; font-size: 1.4rem; line-height: 1.45; color: var(--body-copy); max-width: 670px; margin-top: 22px; }
    .article-body { max-width: 690px; padding-bottom: 18px; font-size: 1.03rem; color: var(--body-copy); }
    .article-body h2 { margin-top: 2.1em; color: var(--text); }
    .article-body h3 { margin-top: 1.8em; color: var(--text); font-size: 1.5rem; }
    .article-body p { margin-bottom: 1.35em; }
    .article-body a { color: var(--accent); text-decoration: underline; }
    .back-link { font: .7rem "DM Mono", monospace; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }
    .page-copy { max-width: 690px; padding-bottom: 10px; color: var(--body-copy); }
    .page-copy h2 { color: var(--text); margin-top: 1.8em; }
    @media (max-width: 620px) {
      .shell { width: min(var(--max), calc(100% - 30px)); }
      .topbar { align-items: flex-start; padding: 19px 0; flex-direction: column; gap: 15px; }
      .nav-side { width: 100%; justify-content: space-between; gap: 12px; }
      nav { gap: 17px; flex-wrap: wrap; }
      .hero { padding: 58px 0 40px; }
      .review-row { grid-template-columns: 1fr; gap: 7px; }
      .rating { padding: 0; }
      .summary { grid-column: auto; }
      .article-head { padding-top: 48px; }
      footer { flex-direction: column; gap: 8px; margin-top: 60px; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; }
    }
  </style>
</head>
<body>
  <header>
    <div class="shell topbar">
      <a class="brand" href="/">After the <span>Credits.</span></a>
      <div class="nav-side">
        <nav aria-label="Main navigation"><a href="/">Journal</a><a href="/about/">About</a></nav>
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch color theme">Light mode</button>
      </div>
    </div>
  </header>
  <main><slot /></main>
  <footer class="shell"><span>AFTER THE CREDITS · A FILM JOURNAL</span><span>Made for the love of looking closer.</span></footer>
  <script is:inline>
    (() => {
      const root = document.documentElement;
      const button = document.getElementById("theme-toggle");
      if (!button) return;
      const updateButton = () => {
        const isLight = root.dataset.theme === "light";
        button.textContent = isLight ? "Dark mode" : "Light mode";
        button.setAttribute("aria-label", isLight ? "Switch to dark mode" : "Switch to light mode");
        button.setAttribute("aria-pressed", String(isLight));
      };
      updateButton();
      button.addEventListener("click", () => {
        const next = root.dataset.theme === "light" ? "dark" : "light";
        root.dataset.theme = next;
        try { localStorage.setItem("atc-theme", next); } catch (_) {}
        updateButton();
      });
    })();
  </script>
</body>
</html>
