---
const { title = "Journal", description = "A personal film journal." } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} /><meta name="theme-color" content="#111110" />
  <title>{title} · After the Credits</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap" rel="stylesheet" />
  <style is:global>
    :root{color-scheme:dark;--bg:#111110;--text:#e8e4dc;--muted:#9b978e;--line:#34332f;--accent:#d9a66b;--max:790px}*{box-sizing:border-box}html{background:var(--bg);scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font-family:"DM Sans",sans-serif;line-height:1.7}a{color:inherit;text-decoration:none}a:hover{color:var(--accent)}.shell{width:min(var(--max),calc(100% - 40px));margin-inline:auto}header{border-bottom:1px solid var(--line)}.topbar{min-height:76px;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand{font-family:"Newsreader",serif;font-size:1.45rem;letter-spacing:-.04em}.brand span{color:var(--accent)}nav{display:flex;gap:22px;font:.75rem "DM Mono",monospace;color:var(--muted);text-transform:uppercase;letter-spacing:.08em}main{min-height:70vh}footer{border-top:1px solid var(--line);margin-top:90px;padding:28px 0 40px;color:var(--muted);font:.72rem "DM Mono",monospace;display:flex;justify-content:space-between;gap:20px}.eyebrow{font:.72rem "DM Mono",monospace;letter-spacing:.13em;text-transform:uppercase;color:var(--accent)}h1,h2,h3{font-family:"Newsreader",serif;font-weight:400;letter-spacing:-.04em;line-height:1.08}h1{font-size:clamp(2.8rem,8vw,5.3rem);margin:18px 0}h2{font-size:2rem}p{margin:0 0 1.15rem}.muted{color:var(--muted)}.rule{border:0;border-top:1px solid var(--line);margin:36px 0}.review-list{list-style:none;padding:0;margin:0}.review-row{padding:25px 0;border-top:1px solid var(--line);display:grid;grid-template-columns:1fr auto;gap:12px 28px}.review-row h3{font-size:1.75rem;margin:0 0 5px}.review-meta{font:.7rem "DM Mono",monospace;color:var(--muted);letter-spacing:.03em}.rating{font:.78rem "DM Mono",monospace;color:var(--accent);white-space:nowrap;padding-top:7px}.summary{grid-column:1/-1;max-width:620px;color:#c0bcb3;font-size:.96rem}.text-link{border-bottom:1px solid #71634f;padding-bottom:2px}.hero{padding:82px 0 58px}.hero p{max-width:570px;font-size:1.08rem;color:#bdb8af}.section-heading{display:flex;justify-content:space-between;align-items:baseline;gap:20px;margin-bottom:8px}.section-heading h2{margin:0}.article-head{padding:70px 0 38px}.article-head h1{font-size:clamp(2.7rem,7vw,4.6rem);max-width:700px}.article-summary{font-family:"Newsreader",serif;font-size:1.4rem;line-height:1.45;color:#c8c2b8;max-width:660px;margin-top:22px}.article-body{max-width:680px;padding-bottom:20px;font-size:1.04rem}.article-body h2{margin-top:2.2em}.article-body p{margin-bottom:1.4em}.back-link{font:.72rem "DM Mono",monospace;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}.empty{padding:36px 0;color:var(--muted)}@media(max-width:560px){.shell{width:min(var(--max),calc(100% - 28px))}.topbar{align-items:flex-start;padding:20px 0;flex-direction:column;gap:12px}nav{gap:16px}.hero{padding:58px 0 42px}.review-row{grid-template-columns:1fr;gap:8px}.rating{padding:0}.summary{grid-column:auto}footer{flex-direction:column;gap:8px}}
  </style>
</head>
<body><header><div class="shell topbar"><a class="brand" href="/">After the <span>Credits.</span></a><nav><a href="/">Journal</a><a href="/about">About</a></nav></div></header><main><slot /></main><footer class="shell"><span>AFTER THE CREDITS · A FILM JOURNAL</span><span>Made for the love of looking closer.</span></footer></body>
</html>
