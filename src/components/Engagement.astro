---
interface Props {
  kind: "review" | "portfolio" | "guestbook";
  slug: string;
  guestbook?: boolean;
}
const { kind, slug, guestbook = false } = Astro.props;
---

<section class:list={["engagement", { "engagement-guestbook": guestbook }]} data-engagement data-entry={`${kind}:${slug}`} aria-label={guestbook ? "Guestbook messages" : "Likes and comments"}>
  <div class="reaction-bar" hidden={guestbook}>
    <div>
      <div class="eyebrow">{guestbook ? "Leave your mark" : "Reader responses"}</div>
      <h2>{guestbook ? "The guestbook." : "Thoughts & reactions"}</h2>
    </div>
    <button type="button" class="like-button" data-like disabled aria-pressed="false" hidden={guestbook}>
      <span data-heart aria-hidden="true">♡</span>
      <span data-like-label>Like</span>
      <span data-like-count class="like-count">0</span>
    </button>
  </div>

  <div class="comment-heading">
    <h3>{guestbook ? "Messages" : "Comments"} <span data-comment-count class="comment-count"></span></h3>
    <p>{guestbook ? "Say hello or leave a recommendation. Messages appear after approval." : "Choose any display name. Comments appear after approval."}</p>
  </div>
  <div class="comments-list" data-comments aria-live="polite">
    <p class="quiet">Loading discussion…</p>
  </div>

  <form class="comment-form" data-comment-form>
    <div class="form-heading">
      <div class="eyebrow">{guestbook ? "Your turn" : "Join the conversation"}</div>
      <h3>{guestbook ? "Leave a message" : "Leave a comment"}</h3>
      <p>{guestbook ? "Introduce yourself or share something worth checking out." : "Share your thoughts. Your comment will appear after approval."}</p>
    </div>
    <div class="form-field">
      <label for={`atc-name-${kind}-${slug}`}>Display name</label>
      <input id={`atc-name-${kind}-${slug}`} name="name" maxlength="40" minlength="2" autocomplete="nickname" placeholder="Your name or nickname" required />
    </div>
    <div class="form-field">
      <label for={`atc-body-${kind}-${slug}`}>{guestbook ? "Your message" : "Your comment"}</label>
      <textarea id={`atc-body-${kind}-${slug}`} name="body" minlength="3" maxlength="1600" rows="3" placeholder={guestbook ? "Leave a message…" : "What did you think?"} required></textarea>
    </div>
    <div class="spam-field" aria-hidden="true">
      <label>Leave this field blank <input name="website" autocomplete="off" tabindex="-1" /></label>
    </div>
    <p class="captcha-note">Verify you are human before {guestbook ? "leaving a message" : "liking or commenting"}.</p>
    <div class="captcha-box" data-captcha></div>
    <div class="verification-help" data-verification-help hidden>
      <p data-verification-detail></p>
      <button type="button" class="verification-retry" data-verification-retry>Retry verification</button>
    </div>
    <button class="submit-comment" type="submit" disabled>{guestbook ? "Submit message" : "Submit comment"}</button>
  </form>
  <p class="engagement-feedback" data-feedback role="status" aria-live="polite"></p>
</section>

<script>
  function buildTextElement(tag, className, text) {
    const element = document.createElement(tag);
    if (className) element.className = className;
    element.textContent = text;
    return element;
  }

  const formatDate = (seconds) => {
    const value = Number(seconds);
    if (!Number.isFinite(value)) return "";
    return new Date(value * 1000).toLocaleDateString("en-US", {
      month: "short", day: "numeric", year: "numeric",
    });
  };

  function turnstileErrorDetails(errorCode) {
    const code = typeof errorCode === "string" || typeof errorCode === "number"
      ? String(errorCode).match(/^\d{5,6}$/)?.[0] ?? ""
      : "";
    let hint = "Try refreshing the page, a private window, or a different browser. Disable blockers for challenges.cloudflare.com.";
    if (code === "110100" || code === "110110" || code === "400020" || code === "400070") {
      hint = "The Turnstile site key is invalid, missing, or disabled. Check the Site Key configured in your Cloudflare Pages production variables.";
    } else if (code === "110200" || code === "400021") {
      hint = "This hostname is not permitted by the Turnstile widget. In Cloudflare Turnstile > your widget > Hostname Management, allow afterthecredits.pages.dev.";
    } else if (code === "200500") {
      hint = "The Cloudflare challenge iframe could not load. Check ad/tracker blockers, VPNs, or network restrictions on challenges.cloudflare.com.";
    } else if (code === "200100") {
      hint = "The challenge detected a clock or caching problem. Check your device time and reload without cache.";
    } else if (code.startsWith("300") || code.startsWith("600")) {
      hint = "Cloudflare could not complete this security challenge. Retry in a private window, or test another browser/network.";
    } else if (code === "110600" || code === "110620") {
      hint = "The challenge timed out. Retry verification.";
    }
    return { code, hint };
  }

  function loadVerificationScript() {
    if (window.turnstile) return Promise.resolve(window.turnstile);
    if (window.__atcTurnstileLoader) return window.__atcTurnstileLoader;
    window.__atcTurnstileLoader = new Promise((resolve, reject) => {
      const script = document.createElement("script");
      script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
      script.async = true;
      script.onload = () => {
        if (window.turnstile) resolve(window.turnstile);
        else reject(new Error("Verification did not load."));
      };
      script.onerror = () => reject(new Error("Verification script was blocked."));
      document.head.appendChild(script);
    });
    return window.__atcTurnstileLoader;
  }

  document.querySelectorAll("[data-engagement]").forEach(async (root) => {
    if (root.dataset.started) return;
    root.dataset.started = "1";

    const entry = root.dataset.entry;
    const likeButton = root.querySelector("[data-like]");
    const likeCount = root.querySelector("[data-like-count]");
    const likeLabel = root.querySelector("[data-like-label]");
    const heart = root.querySelector("[data-heart]");
    const commentCount = root.querySelector("[data-comment-count]");
    const list = root.querySelector("[data-comments]");
    const form = root.querySelector("[data-comment-form]");
    const submitButton = form.querySelector("[type=submit]");
    const captchaMount = root.querySelector("[data-captcha]");
    const feedback = root.querySelector("[data-feedback]");
    const verificationHelp = root.querySelector("[data-verification-help]");
    const verificationDetail = root.querySelector("[data-verification-detail]");
    const verificationRetry = root.querySelector("[data-verification-retry]");
    let liked = false;
    let turnstileToken = "";
    let widgetId = null;
    let busy = false;

    const say = (message, isError = false) => {
      feedback.textContent = message;
      feedback.dataset.error = isError ? "true" : "false";
    };

    function updateLike(count) {
      likeButton.setAttribute("aria-pressed", String(liked));
      likeLabel.textContent = liked ? "Liked" : "Like";
      heart.textContent = liked ? "♥" : "♡";
      likeCount.textContent = String(Math.max(0, Number(count) || 0));
    }

    function showComments(comments) {
      list.replaceChildren();
      commentCount.textContent = `(${comments.length})`;
      if (!comments.length) {
        list.appendChild(buildTextElement("p", "quiet", "No published comments yet. Start the conversation."));
        return;
      }

      for (const item of comments) {
        const card = buildTextElement("article", "reader-comment", "");
        const top = buildTextElement("div", "comment-top", "");
        top.appendChild(buildTextElement("strong", "reader-name", item.name));
        top.appendChild(buildTextElement("time", "comment-date", formatDate(item.createdAt)));
        card.appendChild(top);
        card.appendChild(buildTextElement("p", "reader-message", item.body));
        list.appendChild(card);
      }
    }

    function resetChallenge() {
      turnstileToken = "";
      if (widgetId !== null && window.turnstile) {
        try { window.turnstile.reset(widgetId); }
        catch { /* Keep server-side verification mandatory even if the widget fails. */ }
      }
    }

    verificationRetry.addEventListener("click", () => {
      verificationHelp.hidden = true;
      say("Trying verification again…");
      if (widgetId !== null && window.turnstile) {
        try {
          window.turnstile.reset(widgetId);
          return;
        } catch {
          // An iframe that failed to initialize may need a full page refresh.
        }
      }
      window.location.reload();
    });

    async function perform(action, extra = {}) {
      if (busy) return null;
      if (!turnstileToken) {
        say("Please finish the verification below first.", true);
        return null;
      }
      busy = true;
      likeButton.disabled = true;
      submitButton.disabled = true;
      say("Sending…");
      try {
        const res = await fetch("/api/engagement", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "same-origin",
          body: JSON.stringify({ entry, action, turnstileToken, ...extra }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "Submission failed.");
        say(data.message || "Saved.");
        return data;
      } catch (error) {
        say(error.message || "Please try again.", true);
        return null;
      } finally {
        busy = false;
        likeButton.disabled = false;
        submitButton.disabled = false;
        resetChallenge();
      }
    }

    likeButton.addEventListener("click", async () => {
      const result = await perform(liked ? "unlike" : "like");
      if (result) {
        liked = Boolean(result.liked);
        updateLike(result.count);
      }
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const payload = new FormData(form);
      const result = await perform("comment", {
        name: String(payload.get("name") || ""),
        body: String(payload.get("body") || ""),
        website: String(payload.get("website") || ""),
      });
      if (result) {
        form.querySelector("textarea").value = "";
        say("Thank you! Your comment is awaiting approval.");
      }
    });

    try {
      const response = await fetch(`/api/engagement?entry=${encodeURIComponent(entry)}`, {
        cache: "no-store",
        credentials: "same-origin",
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || "Discussion is unavailable.");
      liked = Boolean(data.liked);
      updateLike(data.count);
      showComments(Array.isArray(data.comments) ? data.comments : []);
      if (!data.siteKey) throw new Error("Verification is not configured.");

      const turnstile = await loadVerificationScript();
      widgetId = turnstile.render(captchaMount, {
        sitekey: data.siteKey,
        theme: "auto",
        action: "atc_engagement",
        callback: (token) => {
          turnstileToken = token;
          verificationHelp.hidden = true;
          say("Verified. You can now like or comment.");
        },
        "expired-callback": () => {
          turnstileToken = "";
          say("Verification expired. Please complete it again.", true);
        },
        "timeout-callback": () => {
          turnstileToken = "";
          say("Verification timed out. Please complete it again.", true);
        },
        "error-callback": (code) => {
          turnstileToken = "";
          const problem = turnstileErrorDetails(code);
          const label = problem.code ? `Cloudflare error ${problem.code}` : "Verification error";
          verificationDetail.textContent = `${label}: ${problem.hint}`;
          verificationHelp.hidden = false;
          say(`${label}. Use Retry verification below, or check the explanation.`, true);
          console.warn("Turnstile widget error:", problem.code || "unknown");
          return true;
        },
      });
      likeButton.disabled = false;
      submitButton.disabled = false;
    } catch (error) {
      const detail = error.message || "This section is temporarily unavailable.";
      list.replaceChildren(buildTextElement("p", "quiet", "Discussion will appear here once it is available."));
      verificationDetail.textContent = detail + " If you use a blocker or privacy extension, allow challenges.cloudflare.com.";
      verificationHelp.hidden = false;
      say(detail, true);
    }
  });
</script>

<style>
  .engagement { max-width: 620px; margin: 94px 0 26px; border-top: 1px solid var(--line); padding-top: 27px; }
  .engagement-guestbook { max-width: 690px; margin: 0 0 26px; padding: 0; border-top: 0; }
  .reaction-bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .reaction-bar[hidden] { display: none; }
  .reaction-bar h2 { font-size: clamp(1.5rem, 4.5vw, 1.9rem); margin: 5px 0 0; }
  .like-button { display: inline-flex; align-items: center; gap: 7px; background: transparent; border: 1px solid var(--line); color: var(--text); border-radius: 3px; padding: 9px 12px; min-height: 40px; cursor: pointer; white-space: nowrap; font: .7rem "DM Mono", monospace; }
  .like-button:hover:not(:disabled) { border-color: var(--accent); color: var(--accent); }
  .like-button[aria-pressed="true"] { color: var(--accent); border-color: var(--accent); }
  .like-button[hidden] { display: none; }
  .like-button:disabled, .submit-comment:disabled { opacity: .5; cursor: not-allowed; }
  [data-heart] { color: var(--accent); font-size: 1.2rem; line-height: 1; }
  .like-count { border-left: 1px solid var(--line); padding-left: 8px; }
  .comment-heading { margin: 30px 0 18px; }
  .comment-heading h3 { font-size: 1.55rem; margin: 0 0 5px; }
  .comment-heading p, .comment-count { font: .71rem "DM Mono", monospace; color: var(--muted); }
  .comment-count { font-size: .77rem; margin-left: 6px; }
  .engagement-guestbook .comment-heading { margin: 0 0 19px; }
  .comments-list { display: grid; gap: 12px; }
  .engagement :global(.reader-comment) { padding: 18px 20px; border: 1px solid var(--line); border-radius: 4px; background: var(--surface); }
  .engagement :global(.comment-top) { display: flex; align-items: baseline; gap: 10px; justify-content: space-between; margin-bottom: 11px; }
  .engagement :global(.reader-name) { font-size: .88rem; color: var(--text); overflow-wrap: anywhere; }
  .engagement :global(.comment-date) { color: var(--muted); font: .65rem "DM Mono", monospace; white-space: nowrap; }
  .engagement :global(.reader-message) { font-size: .91rem; color: var(--body-copy); line-height: 1.65; white-space: pre-wrap; overflow-wrap: anywhere; margin: 0; }
  .engagement :global(.quiet) { color: var(--muted); font-size: .87rem; padding: 19px 20px; margin: 0; background: var(--surface); border: 1px dashed var(--line); border-radius: 4px; }
  .comment-form { display: grid; gap: 15px; margin-top: 37px; padding: 24px 0 0; border-top: 1px solid var(--line); }
  .engagement-guestbook .comment-form { margin-top: 47px; padding-top: 30px; }
  .form-heading { margin-bottom: 6px; }
  .form-heading h3 { font-size: 1.55rem; margin: 6px 0 5px; }
  .form-heading p { margin: 0; font-size: .84rem; color: var(--muted); }
  .form-field { display: grid; gap: 7px; }
  .form-field label { color: var(--text); font: .67rem "DM Mono", monospace; text-transform: uppercase; letter-spacing: .07em; }
  .form-field input, .form-field textarea { width: 100%; color: var(--text); background: var(--surface); border: 1px solid var(--line); border-radius: 4px; padding: 11px 12px; font: .92rem "DM Sans", sans-serif; }
  .form-field input { max-width: 360px; min-height: 43px; }
  .form-field textarea { resize: vertical; line-height: 1.55; min-height: 116px; }
  .form-field input:focus, .form-field textarea:focus { outline: 2px solid var(--accent); outline-offset: 2px; }
  .captcha-note { border-top: 1px solid var(--line); margin: 5px 0 -5px; padding-top: 17px; color: var(--muted); font-size: .77rem; }
  .captcha-box { min-height: 0; }
  .verification-help[hidden] { display: none; }
  .verification-help { border-left: 2px solid var(--accent); padding: 4px 0 4px 14px; color: var(--body-copy); font-size: .82rem; line-height: 1.5; }
  .verification-help p { margin: 0 0 11px; }
  .verification-retry { background: transparent; color: var(--text); border: 1px solid var(--line); border-radius: 3px; padding: 8px 11px; cursor: pointer; font: .7rem "DM Mono", monospace; }
  .verification-retry:hover { color: var(--accent); border-color: var(--accent); }
  .submit-comment { justify-self: start; padding: 11px 17px; min-height: 43px; color: var(--bg); background: var(--text); border: 0; border-radius: 3px; cursor: pointer; font: .72rem "DM Mono", monospace; }
  .submit-comment:hover:not(:disabled) { background: var(--accent); }
  .engagement-feedback { font-size: .78rem; color: var(--muted); min-height: 1.2rem; margin: 12px 0 0; }
  .engagement-feedback[data-error="true"] { color: var(--accent); }
  .spam-field { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  @media (max-width: 620px) {
    .engagement { margin-top: 72px; padding-top: 22px; }
    .engagement-guestbook { margin-top: 0; padding-top: 0; }
    .reaction-bar { align-items: flex-start; flex-direction: column; gap: 13px; }
    .like-button { align-self: flex-start; min-height: 44px; }
    .submit-comment { min-height: 44px; }
    .engagement :global(.reader-comment) { padding: 15px; }
    .engagement :global(.comment-top) { align-items: flex-start; flex-wrap: wrap; }
  }
</style>
