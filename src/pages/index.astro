---
import BaseLayout from "../layouts/BaseLayout.astro";
import StarRating from "../components/StarRating.astro";
import { getCollection, render } from "astro:content";

const reviews = (await getCollection("reviews"))
  .sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0));
const pages = await getCollection("pages");
const home = pages.find((page) => page.data.slug === "home");
const homeContent = home ? await render(home) : null;
const HomeContent = homeContent?.Content;
const dateLabel = (date) => date.toLocaleDateString("en-US", {
  month: "short", day: "numeric", year: "numeric", timeZone: "UTC"
});
---
<BaseLayout title={home?.data.title ?? "Journal"} description={home?.data.intro ?? "A personal film journal of reviews and reflections."}>
  <div class="shell">
    <section class="hero">
      <div class="eyebrow">{home?.data.eyebrow ?? "Notes on cinema · An independent film journal"}</div>
      <h1>{home?.data.headline ?? "Films worth thinking about."}</h1>
      <p>{home?.data.intro ?? "A personal journal of movies, images, and ideas that stay with you after the screen goes dark."}</p>
      {HomeContent && <div class="page-copy"><HomeContent /></div>}
    </section>
    {(home?.data.currentlyWatching || home?.data.currentlyReading || home?.data.currentlyListening || home?.data.currentlyPlaying) && (
      <section class="currently" aria-label="Currently experiencing">
        <div class="eyebrow">At the moment</div>
        <h2>Currently experiencing.</h2>
        <div class="currently-grid">
          {home?.data.currentlyWatching && <div class="currently-item">
            {home.data.currentlyWatchingCover && <img src={home.data.currentlyWatchingCover} alt={`Poster for ${home.data.currentlyWatching}`} loading="lazy" decoding="async" />}
            <div><span>Watching</span><p>{home.data.currentlyWatching}</p></div>
          </div>}
          {home?.data.currentlyReading && <div class="currently-item">
            {home.data.currentlyReadingCover && <img src={home.data.currentlyReadingCover} alt={`Cover for ${home.data.currentlyReading}`} loading="lazy" decoding="async" />}
            <div><span>Reading</span><p>{home.data.currentlyReading}</p></div>
          </div>}
          {home?.data.currentlyListening && <div class="currently-item currently-item--album">
            {home.data.currentlyListeningCover && <img src={home.data.currentlyListeningCover} alt={`Artwork for ${home.data.currentlyListening}`} loading="lazy" decoding="async" />}
            <div><span>Listening</span><p>{home.data.currentlyListening}</p></div>
          </div>}
          {home?.data.currentlyPlaying && <div class="currently-item">
            {home.data.currentlyPlayingCover && <img src={home.data.currentlyPlayingCover} alt={`Artwork for ${home.data.currentlyPlaying}`} loading="lazy" decoding="async" />}
            <div><span>Playing</span><p>{home.data.currentlyPlaying}</p></div>
          </div>}
        </div>
      </section>
    )}
    <section aria-labelledby="latest">
      <div class="section-heading">
        <h2 id="latest">{home?.data.sectionHeading ?? "Recent writing"}</h2>
        <span class="muted review-meta">{reviews.length} {reviews.length === 1 ? "review" : "reviews"}</span>
      </div>
      {reviews.length ? (
        <ul class="review-list">
          {reviews.map((review) => (
            <li class="review-row">
              <div>
                <a href={`/reviews/${review.data.slug || review.id}/`}><h3>{review.data.title}</h3></a>
                <div class="review-meta">{[review.data.year, review.data.director && `Dir. ${review.data.director}`, review.data.date && dateLabel(review.data.date)].filter(Boolean).join(" · ")}</div>
              </div>
              {review.data.rating != null && <div class="rating">
                <StarRating value={review.data.rating} />
              </div>}
              {review.data.summary && <p class="summary">{review.data.summary}</p>}
              <div><a class="text-link review-meta" href={`/reviews/${review.data.slug || review.id}/`}>Read review ↗</a></div>
            </li>
          ))}
        </ul>
      ) : <div class="empty">No reviews yet. Add your first one through Pages CMS and it will appear here.</div>}
    </section>
    <hr class="rule" />
    <p class="muted">{home?.data.closingNote ?? "A living archive of things seen, felt, and thought."}</p>
    <p class="artwork-credit">Automatic artwork sources: <a href="https://www.themoviedb.org" target="_blank" rel="noopener noreferrer">TMDB</a> · <a href="https://openlibrary.org" target="_blank" rel="noopener noreferrer">Open Library</a> / <a href="https://jikan.moe" target="_blank" rel="noopener noreferrer">Jikan</a> (manga) · <a href="https://musicbrainz.org" target="_blank" rel="noopener noreferrer">MusicBrainz</a> / <a href="https://coverartarchive.org" target="_blank" rel="noopener noreferrer">Cover Art Archive</a> · <a href="https://rawg.io" target="_blank" rel="noopener noreferrer">RAWG</a></p>
  </div>
</BaseLayout>
<style>
.currently{border-top:1px solid var(--line);margin-bottom:47px;padding-top:22px}
.currently h2{font-size:1.7rem;margin:6px 0 19px}
.currently-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px 28px}
.currently-item{display:flex;align-items:flex-start;gap:13px;min-width:0}
.currently-item img{display:block;width:74px;height:108px;flex:none;object-fit:cover;background:var(--surface);border:1px solid var(--line);border-radius:2px}
.currently-item--album img{width:94px;height:94px;aspect-ratio:1 / 1;object-fit:cover}
.currently-item > div{min-width:0}
.currently-grid p{color:var(--body-copy);font-size:.92rem;margin:0;overflow-wrap:anywhere}
.currently-grid span{display:block;font:.65rem "DM Mono",monospace;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin-bottom:3px}
.artwork-credit{margin:42px 0 28px;padding-top:18px;border-top:1px solid var(--line);color:var(--muted);font:.61rem "DM Mono",monospace;line-height:1.7}
.artwork-credit a{text-decoration:underline;text-decoration-color:var(--line)}
@media(max-width:620px){.currently-grid{grid-template-columns:1fr}}
</style>
