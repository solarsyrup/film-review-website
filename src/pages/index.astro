---
import BaseLayout from "../layouts/BaseLayout.astro";
import StarRating from "../components/StarRating.astro";
import { getCollection, render } from "astro:content";

const [reviews, diary, commonplace, projects, pages] = await Promise.all([
 getCollection("reviews"),getCollection("diary"),getCollection("commonplace"),getCollection("projects"),getCollection("pages")
]);
const home=pages.find(page=>page.data.slug==="home");
const rendered=home?await render(home):null;
const HomeContent=rendered?.Content;
const clean=(body:string)=>body
 .replace(/^---\s*[\s\S]*?\n---\s*/,"")
 .replace(/![[^\]]*\]\([^)]*\)/g,"")
 .replace(/^#{1,6}\s+.*$/gm,"")
 .replace(/\[([^\]]+)\]\([^)]+\)/g,"$1")
 .replace(/[*_~`>#]/g,"")
 .replace(/\s+/g," ").trim();
type Entry={type:"Journal"|"Diary"|"Commonplace"|"Portfolio";title:string;date:number;sortTime:number;url:string;excerpt:string;image?:string;medium?:string;director?:string;year?:number;rating?:number};
const entries:Entry[]=[
 ...reviews.map(r=>({type:"Journal" as const,title:r.data.title,date:r.data.date?.getTime()??0,sortTime:r.data.feedSortAt?.getTime()??r.data.publishedAt?.getTime()??r.data.date?.getTime()??0,url:`/reviews/${r.data.slug||r.id}/`,excerpt:"",image:r.data.cover,medium:r.data.medium||"Film",director:r.data.director,year:r.data.year,rating:r.data.rating})),
 ...diary.map(d=>({type:"Diary" as const,title:d.data.title,date:d.data.date.getTime(),sortTime:d.data.feedSortAt?.getTime()??d.data.publishedAt?.getTime()??d.data.date.getTime(),url:`/diary/#${d.data.slug||d.id}`,excerpt:d.data.note||"",image:d.data.cover,medium:d.data.medium})),
 ...commonplace.map(c=>({type:"Commonplace" as const,title:c.data.title||"Untitled thought",date:c.data.date.getTime(),sortTime:c.data.feedSortAt?.getTime()??c.data.publishedAt?.getTime()??c.data.date.getTime(),url:`/commonplace/#${c.data.slug||c.id}`,excerpt:clean(c.body||"")||c.data.source||"",medium:c.data.category})),
 ...projects.map(p=>({type:"Portfolio" as const,title:p.data.title,date:p.data.date?.getTime()??(p.data.year?Date.UTC(p.data.year,0,1):0),sortTime:p.data.feedSortAt?.getTime()??p.data.publishedAt?.getTime()??p.data.date?.getTime()??(p.data.year?Date.UTC(p.data.year,0,1):0),url:`/portfolio/${p.data.slug||p.id}/`,excerpt:p.data.description||clean(p.body||""),image:p.data.cover||undefined,medium:p.data.category||"Other"}))
].sort((a,b)=>b.sortTime-a.sortTime||b.date-a.date||a.title.localeCompare(b.title)).slice(0,6);
const dateLabel=(time:number)=>time?new Date(time).toLocaleDateString("en-US",{month:"short",day:"numeric",year:"numeric",timeZone:"UTC"}):"Undated";
---
<BaseLayout title="Home" description="After the Credits — a journal of art, thoughts and things I've made.">
 <div class="shell">
  <section class="hero home-hero">
   <div class="eyebrow">{home?.data.eyebrow??"Notes on cinema · An independent film journal"}</div>
   <h1>After the Credits.</h1>
   <p>A personal journal of art, thoughts, and things I've made. Mostly films, but not all.</p>
   {HomeContent&&<div class="page-copy"><HomeContent/></div>}
  </section>
  {(home?.data.currentlyWatching||home?.data.currentlyReading||home?.data.currentlyListening||home?.data.currentlyPlaying)&&
  <section class="currently" aria-label="Currently experiencing">
   <h2>Currently experiencing.</h2>
   <p class="section-intro">Small snapshot of what I've been doing.</p>
   <div class="current-grid">
    {home?.data.currentlyWatching&&<div class="current-item">
     {home.data.currentlyWatchingCover&&<img src={home.data.currentlyWatchingCover} alt={`Poster for ${home.data.currentlyWatching}`} loading="lazy"/>}
     <div class="eyebrow">Watching</div><h3>{home.data.currentlyWatching}</h3>
    </div>}
    {home?.data.currentlyReading&&<div class="current-item">
     {home.data.currentlyReadingCover&&<img src={home.data.currentlyReadingCover} alt={`Cover for ${home.data.currentlyReading}`} loading="lazy"/>}
     <div class="eyebrow">Reading</div><h3>{home.data.currentlyReading}{home.data.currentlyReadingVolume?` · Vol. ${home.data.currentlyReadingVolume}`:""}</h3>
     {home.data.currentlyReadingAuthor&&<p>{home.data.currentlyReadingAuthor}</p>}
    </div>}
    {home?.data.currentlyListening&&<div class="current-item album">
     {home.data.currentlyListeningCover&&<img src={home.data.currentlyListeningCover} alt={`Artwork for ${home.data.currentlyListening}`} loading="lazy"/>}
     <div class="eyebrow">Listening</div><h3>{home.data.currentlyListening}</h3>
     {home.data.currentlyListeningArtist&&<p>{home.data.currentlyListeningArtist}</p>}
    </div>}
    {home?.data.currentlyPlaying&&<div class="current-item">
     {home.data.currentlyPlayingCover&&<img src={home.data.currentlyPlayingCover} alt={`Artwork for ${home.data.currentlyPlaying}`} loading="lazy"/>}
     <div class="eyebrow">Playing</div><h3>{home.data.currentlyPlaying}</h3>
    </div>}
   </div>
  </section>}
  <section class="recent" aria-labelledby="recent-title">
   <div class="recent-head"><h2 id="recent-title">Recently added.</h2>
    <label class="review-meta" for="recent-filter">Show <select id="recent-filter">
     <option value="all">Everything</option><option value="Journal">Journal</option><option value="Diary">Diary</option><option value="Commonplace">Commonplace</option><option value="Portfolio">Portfolio</option>
    </select></label>
   </div>
   {entries.length?<div class="recent-entries">
    {entries.map(entry=><a class="recent-entry" href={entry.url} data-type={entry.type}>
     <div class="entry-image">
      {entry.image?<img src={entry.image} alt="" loading="lazy" decoding="async"/>:<span>{entry.type==="Commonplace"?"✎":entry.type}</span>}
     </div>
     <div class="entry-text">
      <div class="review-meta">{entry.type}{entry.medium?` · ${entry.medium}`:""}{entry.date?` · ${dateLabel(entry.date)}`:""}</div>
      <h3>{entry.title}</h3>
      {entry.type==="Journal"&&<div class="review-details review-meta">{[entry.year,entry.director&&`Dir. ${entry.director}`].filter(Boolean).join(" · ")}</div>}
      {entry.type==="Journal"&&entry.rating!=null&&<div class="home-rating"><StarRating value={entry.rating}/></div>}
      {entry.type!=="Journal"&&entry.excerpt&&<p>{entry.excerpt}</p>}
      <span class="entry-more">Read entry ↗</span>
     </div>
    </a>)}
   </div>:<p class="empty">Nothing published just yet. New Journal, Diary, Commonplace and Portfolio entries will appear here.</p>}
   <p class="empty" id="recent-empty" hidden>No recent entries in that section.</p>
   <div class="recent-links"><a class="text-link review-meta" href="/journal/">Explore the Journal ↗</a><a class="text-link review-meta" href="/commonplace/">Open the Commonplace Book ↗</a></div>
  </section>
  <p class="artwork-credit">Automatic artwork sources: <a href="https://www.themoviedb.org" target="_blank" rel="noopener noreferrer">TMDB</a> · <a href="https://openlibrary.org" target="_blank" rel="noopener noreferrer">Open Library</a> / <a href="https://jikan.moe" target="_blank" rel="noopener noreferrer">Jikan</a> (manga) · <a href="https://musicbrainz.org" target="_blank" rel="noopener noreferrer">MusicBrainz</a> / <a href="https://coverartarchive.org" target="_blank" rel="noopener noreferrer">Cover Art Archive</a> · <a href="https://rawg.io" target="_blank" rel="noopener noreferrer">RAWG</a></p>
 </div>
</BaseLayout>
<script>
const select=document.getElementById("recent-filter") as HTMLSelectElement;
const entries=[...document.querySelectorAll<HTMLElement>(".recent-entry")];
const empty=document.getElementById("recent-empty");
select?.addEventListener("change",()=>{
 let shown=0;
 for(const item of entries){const match=select.value==="all"||item.dataset.type===select.value;item.hidden=!match;if(match)shown++;}
 if(empty)empty.hidden=shown!==0;
});
</script>
<style>
.home-hero{padding-bottom:46px}
.currently{border-top:1px solid var(--line);margin-bottom:53px;padding-top:24px}
.currently h2,.recent h2{font-size:2rem;margin:0 0 8px}
.section-intro{color:var(--muted);font-size:.85rem;margin-bottom:22px}
.current-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}
.current-item{min-width:0}
.current-item img{display:block;width:100%;aspect-ratio:3/4;object-fit:cover;border:1px solid var(--line);background:var(--surface);margin-bottom:13px}
.current-item.album img{aspect-ratio:1/1;object-fit:cover}
.current-item .eyebrow{font-size:.63rem;margin-bottom:7px}
.current-item h3{font-size:1.13rem;line-height:1.2;margin:0 0 4px;overflow-wrap:anywhere}
.current-item p{font-size:.75rem;color:var(--muted);line-height:1.4;overflow-wrap:anywhere}
.recent-head{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:15px;margin-bottom:19px}
.recent-head label{display:flex;align-items:center;gap:8px}
.recent-head select{padding:9px 11px;background:var(--surface);color:var(--text);border:1px solid var(--line);font:.73rem "DM Mono",monospace}
.recent-entry{display:grid;grid-template-columns:85px minmax(0,1fr);gap:20px;border-top:1px solid var(--line);padding:21px 0}
.recent-entry[hidden]{display:none}
.entry-image{aspect-ratio:3/4;background:var(--surface);border:1px solid var(--line);display:grid;place-items:center;color:var(--muted);font:1rem "Newsreader",Georgia,serif;text-align:center;overflow:hidden}
.entry-image img{width:100%;height:100%;object-fit:cover}
.entry-text{min-width:0}
.entry-text h3{font-size:1.6rem;margin:7px 0 6px}
.entry-text p{font-size:.88rem;color:var(--body-copy);margin:0 0 9px;overflow:hidden;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow-wrap:anywhere}
.review-details{margin:4px 0 6px}
.home-rating{color:var(--accent);margin:4px 0 8px;font-size:.8rem}
.entry-more{font:.67rem "DM Mono",monospace;color:var(--accent)}
.recent-links{display:flex;flex-wrap:wrap;gap:23px;margin:24px 0}
.artwork-credit{margin:50px 0 28px;padding-top:18px;border-top:1px solid var(--line);color:var(--muted);font:.61rem "DM Mono",monospace;line-height:1.7}
.artwork-credit a{text-decoration:underline;text-decoration-color:var(--line)}
@media(max-width:620px){.current-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:20px 15px}.recent-entry{grid-template-columns:68px minmax(0,1fr);gap:14px}}
</style>