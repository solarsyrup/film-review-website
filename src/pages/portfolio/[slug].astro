---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { resolveProjectEmbed } from "../../utils/projectEmbeds.mjs";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.data.slug || project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const rawLink = project.data.link?.trim();
const externalLink = rawLink && /^https?:\/\//i.test(rawLink) ? rawLink : null;
const embeddedMedia = resolveProjectEmbed(project.data.embedLink) ?? resolveProjectEmbed(project.data.link);
const rawMedia = project.data.mediaFile?.trim();
const mediaFile = rawMedia && (rawMedia.startsWith("/") || /^https?:\/\//i.test(rawMedia)) ? rawMedia : null;
const fileExtension = (mediaFile ?? "").split(/[?#]/)[0].toLowerCase();
const isVideo = /\.(mp4|webm|ogv)$/.test(fileExtension);
const isAudio = /\.(mp3|m4a|wav|ogg|flac)$/.test(fileExtension);
const gallery = project.data.gallery ?? [];
const prettyDate = project.data.date?.toLocaleDateString("en-US", {
  month: "long", day: "numeric", year: "numeric", timeZone: "UTC",
});
---

<BaseLayout title={project.data.title} description={project.data.description ?? `${project.data.category ?? "Creative"} work: ${project.data.title}`}>
  <article class="shell">
    <div class="work-head">
      <a class="back-link" href="/portfolio/">← All projects</a>
      <div class="eyebrow" style="margin-top:35px">{project.data.category ?? "Other"} {project.data.year ? `· ${project.data.year}` : ""}</div>
      <h1>{project.data.title}</h1>
      {project.data.role && <p class="work-role">{project.data.role}</p>}
      {project.data.description && <p class="work-summary">{project.data.description}</p>}
      {prettyDate && <p class="review-meta">Added {prettyDate}</p>}
    </div>

    {project.data.cover && (
      <figure class="work-cover">
        <img src={project.data.cover} alt={project.data.coverAlt ?? project.data.title} />
      </figure>
    )}

    {(mediaFile || externalLink || embeddedMedia) && (
      <section class="work-resources" aria-label="Project media">
        {mediaFile && isVideo && (
          <video controls playsinline preload="metadata" poster={project.data.cover} src={mediaFile}>
            Your browser does not support this video.
          </video>
        )}
        {mediaFile && isAudio && (
          <audio controls preload="metadata" src={mediaFile}>
            Your browser does not support this audio.
          </audio>
        )}
        {embeddedMedia && (
          <div class="external-embed">
            <div class="embed-label">{embeddedMedia.provider} player</div>
            <iframe
              class:list={["embed-frame", `embed-${embeddedMedia.kind}`]}
              src={embeddedMedia.src}
              title={`${project.data.title} — ${embeddedMedia.provider} player`}
              width="100%"
              height={embeddedMedia.height}
              style={embeddedMedia.provider === "Bandcamp" ? `max-width: ${embeddedMedia.width ?? 400}px; height: ${embeddedMedia.height}px;` : undefined}
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              allow="autoplay; encrypted-media; fullscreen; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        )}
        {(mediaFile || externalLink) && (
          <div class="resource-links">
            {mediaFile && <a href={mediaFile} target="_blank" rel="noopener noreferrer">Open uploaded file ↗</a>}
            {externalLink && <a href={externalLink} target="_blank" rel="noopener noreferrer">{embeddedMedia?.provider === "Bandcamp" ? "Listen on Bandcamp ↗" : "View the project online ↗"}</a>}
          </div>
        )}
      </section>
    )}

    {gallery.length > 0 && (
      <section class="work-gallery" aria-label="Project gallery">
        {gallery.map((src, index) => (
          <figure>
            <a href={src} target="_blank" rel="noopener noreferrer" aria-label={`Open image ${index + 1}`}>
              <img src={src} alt={`${project.data.title}, image ${index + 1}`} loading="lazy" />
            </a>
          </figure>
        ))}
      </section>
    )}

    <div class="article-body work-writing">
      <Content />
    </div>

    <hr class="rule" />
    <a class="back-link" href="/portfolio/">← Back to portfolio</a>
  </article>
</BaseLayout>

<style>
  .work-head { padding: 62px 0 35px; }
  .work-head h1 { font-size: clamp(2.7rem, 7vw, 4.5rem); max-width: 740px; }
  .work-role { font: .72rem "DM Mono", monospace; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); }
  .work-summary { font-family: "Newsreader", Georgia, serif; font-size: clamp(1.2rem, 3.3vw, 1.55rem); line-height: 1.42; color: var(--body-copy); max-width: 680px; margin-top: 17px; }
  .work-cover { margin: 0 0 32px; }
  .work-cover img { display: block; width: 100%; max-height: 680px; object-fit: contain; background: var(--surface); }
  .work-resources { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 26px 0; margin: 0 0 35px; }
  .work-resources video { display: block; width: 100%; max-height: 500px; background: #111; }
  .work-resources audio { display: block; width: min(100%, 550px); }
  .external-embed { width: 100%; margin: 3px 0 18px; }
  .embed-label { color: var(--muted); font: .67rem "DM Mono", monospace; text-transform: uppercase; letter-spacing: .1em; margin-bottom: 11px; }
  .embed-frame { display: block; width: 100%; max-width: 100%; border: 0; background: var(--surface); }
  .embed-frame.embed-video { aspect-ratio: 16 / 9; height: auto; background: #111; }
  .embed-frame.embed-document { min-height: 460px; }
  .resource-links { display: flex; flex-wrap: wrap; gap: 12px 28px; margin-top: 16px; }
  .resource-links a { color: var(--accent); font: .72rem "DM Mono", monospace; border-bottom: 1px solid var(--line); padding-bottom: 3px; }
  .work-gallery { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 15px; margin: 26px 0 42px; }
  .work-gallery figure { margin: 0; min-width: 0; }
  .work-gallery img { width: 100%; height: 100%; max-height: 600px; object-fit: contain; background: var(--surface); display: block; }
  .work-writing { padding-top: 5px; min-height: 15px; }
  @media (max-width: 620px) {
    .work-head { padding-top: 45px; }
    .work-gallery { grid-template-columns: 1fr; }
  }
</style>
