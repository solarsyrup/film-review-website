---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StarRating from "../../components/StarRating.astro";
import Engagement from "../../components/Engagement.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const reviews = await getCollection("reviews");
  return reviews.map((review) => ({
    params: { slug: review.data.slug || review.id },
    props: { review },
  }));
}

const { review } = Astro.props;
const { Content } = await render(review);
const dateLabel = review.data.date?.toLocaleDateString("en-US", {
  month: "long", day: "numeric", year: "numeric", timeZone: "UTC"
});
---

<BaseLayout title={review.data.title} description={review.data.summary ?? `A review of ${review.data.title}.`}>
  <article class="shell">
    <div class="article-head">
      <a class="back-link" href="/">← Back to journal</a>
      <div class="eyebrow" style="margin-top:34px">Film review</div>
      <h1>{review.data.title}</h1>
      <div class="review-meta">{[review.data.year, review.data.director && `Directed by ${review.data.director}`, dateLabel && `Reviewed ${dateLabel}`].filter(Boolean).join(" · ")}</div>
      {review.data.rating != null && <div class="rating" style="margin-top:18px"><StarRating value={review.data.rating} /></div>}
      {review.data.summary && <p class="article-summary">{review.data.summary}</p>}
    </div>
    <hr class="rule" style="margin-top:0" />
    <div class="article-body">
      <Content />
    </div>
    {review.data.spoilerText && (
      <details class="spoiler-section">
        <summary>{review.data.spoilerHeading || "Reveal spoilers"}</summary>
        <div class="spoiler-copy">{review.data.spoilerText}</div>
      </details>
    )}
    <Engagement kind="review" slug={review.data.slug || review.id} />
    <hr class="rule" />
    <a class="back-link" href="/">← More writing</a>
  </article>
</BaseLayout>
<style>
.spoiler-section{max-width:690px;margin:24px 0;padding:13px 17px;background:var(--surface);border:1px solid var(--line)}
.spoiler-section summary{color:var(--accent);cursor:pointer;font:.75rem "DM Mono",monospace;letter-spacing:.04em}
.spoiler-copy{padding-top:15px;white-space:pre-wrap;color:var(--body-copy);font-size:1rem;line-height:1.72;overflow-wrap:anywhere}
</style>
